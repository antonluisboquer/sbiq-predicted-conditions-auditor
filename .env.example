# LLM provider key for the judge step (ocr_auditor/judge.py).
ANTHROPIC_API_KEY=

# Overrides ocr_auditor.judge.DEFAULT_MODEL.
AUDITOR_MODEL=claude-sonnet-4-5-20250929

# Only needed once S3 access to tasktile-staging is arranged
# (docs/ocr-auditor-agent-spec.md open question #1). Not required for
# scripts/run_local.py (uses LocalDirOCRTextFetcher instead).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# infra/ (cdk deploy) only -- this is a brand-new stack with no established
# account/region default yet.
OCR_AUDITOR_AWS_ACCOUNT_ID=
OCR_AUDITOR_AWS_REGION=
OCR_AUDITOR_STAGE=dev
# Set once cross-account/bucket-policy access to Tasktile's OCR bucket is
# arranged -- see docs/tasktile-bucket-access-request.md. Set
# OCR_SOURCE_BUCKET_NAME if Tasktile grants a direct bucket-policy GetObject,
# or OCR_SOURCE_BUCKET_ROLE_ARN if they expose an assumable cross-account
# role instead (only one of the two is needed).
OCR_SOURCE_BUCKET_NAME=
OCR_SOURCE_BUCKET_ROLE_ARN=
