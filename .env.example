# LLM provider key for the judge step (ocr_auditor/judge.py).
ANTHROPIC_API_KEY=

# Overrides ocr_auditor.judge.DEFAULT_MODEL.
AUDITOR_MODEL=claude-sonnet-4-5-20250929

# Dedicated Tasktile-OCR-scoped S3 credentials (deliberately separate from
# predicted-conditions' own general AWS creds) -- used by
# ocr_auditor.ocr_fetcher.S3OCRTextFetcher.from_env(). Not required if
# you're only running scripts/run_local.py with --ocr-dir
# (LocalDirOCRTextFetcher reads local fixtures instead, no AWS needed).
TASK_TILE_S3_ACCESS_KEY=
TASK_TILE_S3_SECRET_KEY=
# Deliberately NOT named "AWS_REGION" -- that name is reserved by the AWS
# Lambda runtime (always force-set to wherever the function is deployed),
# so it can't be trusted to pin this client to tasktile-staging's own
# region. Locally it's just a plain env var either way.
TASK_TILE_S3_REGION=us-west-2
# Unused by the code (each AuditRequest carries its own `bucket` field --
# see ocr_auditor/contracts.py) -- kept here only as a reference/reminder
# of which bucket these credentials are scoped to.
TASK_TILE_S3_BUCKET=tasktile-staging

# Only read by the DEPLOYED Lambda (not by scripts/run_local.py) -- the
# static key callers must send as the `x-api-key` header to the Function
# URL, since it's deployed with FunctionUrlAuthType.NONE (see
# infra/stacks/ocr_auditor_stack.py and api/main.py:_check_api_key).
# Generate with `openssl rand -hex 24`, same as predicted-conditions' own
# API_KEY. Pushed to Secrets Manager out-of-band, never set here for real
# deploys -- this .env value is only used by scripts that call the
# deployed agent directly over HTTP for local testing.
API_KEY=

# infra/ (cdk deploy) only -- deployed into predicted-conditions' own
# existing AWS account/region (same shared account, see README.md).
OCR_AUDITOR_AWS_ACCOUNT_ID=828351637694
OCR_AUDITOR_AWS_REGION=us-east-2
OCR_AUDITOR_STAGE=dev
# Lambda runtime env vars (set via CDK, not this .env) -- only one of the
# two is needed, if the OCR source bucket grants access via a direct
# bucket policy vs. an assumable cross-account role, respectively.
OCR_SOURCE_BUCKET_NAME=
OCR_SOURCE_BUCKET_ROLE_ARN=
